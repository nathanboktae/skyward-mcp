SKYWARD_BASE_URL=https://www.q.wa-k12.net/lkwash/
SKYWARD_USERNAME=
SKYWARD_PASSWORD=
SKYWARD_TIMEZONE=America/Los_Angeles
SKYWARD_TIMEOUT_MS=45000

# HTTP transport (npm run start:http)
SKYWARD_HTTP_HOST=127.0.0.1
SKYWARD_HTTP_PORT=3000
# Required for non-loopback listeners; use a random secret of at least 32 characters.
# SKYWARD_HTTP_TOKEN=

# Local default: chrome. HA container uses bundled chromium.
SKYWARD_BROWSER=chrome
